<!--
    NPC Dialogue HUD Template - HYUIML
    ==================================
    
    Bottom-center modal dialogue window for NPC conversations with quest integration.
    
    Template Variables:
      {{$npc.name}}         - NPC display name
      {{$npc.avatarId}}     - Hyvatar username for portrait
      {{$currentText}}      - Current dialogue text
      {{$choices}}          - Array of dialogue options
      {{$showQuestOffer}}   - Boolean: show quest offer mode
      {{$quest}}            - Quest offer details (if showQuestOffer)
    
    Command to reload:
      /uireload npc-dialogue
    
    HyUI CSS Compliance Notes:
      - Unsupported: padding-*, margin-*, gap, border-*, opacity, text-decoration,
                     transform, line-height, box-shadow, border-radius, letter-spacing
      - Supported: layout-mode, anchor-*, flex-weight, color, font-size, font-weight,
                   text-transform, background-color, background-image, visibility,
                   text-align, vertical-align, horizontal-align
      - For hover/disabled states: use custom-textbutton with data-hyui-*-label-style
    
    Author: Argonath Systems
    Version: 1.1.0
    Spec: VDD-MISC-005-quest-001-npc-dialogue.md
-->

<style>
    /* === NPC Dialogue HUD Styles (LOTR Theme) === */
    /* HyUI CSS Compliant - Removed unsupported properties */
    
    .hud-npc-dialogue {
        layout-mode: Top;
        anchor-bottom: 50;
        anchor-left: 50%;
        anchor-width: 700;
        anchor-height: 300;
        background-color: rgba(45, 36, 30, 0.95);
    }
    
    .dialogue-container {
        layout-mode: Left;
        flex-weight: 1;
    }
    
    /* NPC Portrait Section */
    .npc-portrait {
        layout-mode: Top;
        anchor-width: 100;
    }
    
    .portrait-image {
        anchor-width: 80;
        anchor-height: 100;
    }
    
    /* Dialogue Content */
    .dialogue-content {
        layout-mode: Top;
        flex-weight: 1;
    }
    
    .npc-header {
        layout-mode: Left;
    }
    
    .npc-name {
        font-size: 18;
        font-weight: bold;
        color: #d4a017;
        text-transform: uppercase;
    }
    
    .dialogue-text {
        background-color: rgba(0, 0, 0, 0.2);
        anchor-height: 60;
    }
    
    .speech-text {
        font-size: 14;
        color: #f4e8d0;
    }
    
    .dialogue-divider {
        background-color: #6b5d4f;
        anchor-height: 1;
    }
    
    /* Dialogue Choices - uses custom-textbutton for state styling */
    .dialogue-choices {
        layout-mode: Top;
    }
    
    .dialogue-choice {
        layout-mode: Left;
        anchor-height: 28;
    }
    
    .choice-number {
        color: #d4a017;
        font-weight: bold;
        font-size: 13;
    }
    
    .choice-text {
        color: #f4e8d0;
        font-size: 13;
        flex-weight: 1;
    }
    
    .choice-type {
        color: #a89885;
        font-size: 11;
    }
    
    /* Quest Offer Section */
    .quest-offer {
        layout-mode: Top;
        background-color: rgba(0, 0, 0, 0.3);
    }
    
    .quest-title {
        font-size: 16;
        font-weight: bold;
        color: #d4a017;
        text-transform: uppercase;
    }
    
    .quest-objectives {
        layout-mode: Top;
    }
    
    .quest-objective-item {
        font-size: 13;
        color: #f4e8d0;
    }
    
    .rewards-section {
        layout-mode: Top;
    }
    
    .rewards-label {
        font-weight: bold;
        color: #f4e8d0;
        font-size: 13;
        text-transform: uppercase;
    }
    
    .reward-items {
        layout-mode: Left;
    }
    
    .reward-xp {
        color: #90ee90;
        font-size: 13;
        font-weight: bold;
    }
    
    .reward-gold {
        color: #d4a017;
        font-size: 13;
        font-weight: bold;
    }
    
    .quest-actions {
        layout-mode: Right;
    }
    
    /* Footer */
    .dialogue-footer {
        layout-mode: Right;
    }
    
    .close-hint {
        font-size: 10;
        color: #a89885;
    }
    
    /* Disabled choice styling is handled via data-hyui-disabled-label-style */
    /* on the custom-textbutton element in the HTML section below */
</style>

<div class="hud-npc-dialogue">
    <div class="dialogue-container">
        <!-- NPC Portrait Section -->
        <div class="npc-portrait">
            <hyvatar id="npc-avatar" 
                     src="{{$npc.avatarId}}" 
                     data-hyui-render-type="head" 
                     data-hyui-size="128" 
                     class="portrait-image">
            </hyvatar>
        </div>
        
        <!-- Dialogue Content Section -->
        <div class="dialogue-content">
            <!-- NPC Header -->
            <div class="npc-header">
                <p id="npc-name" class="npc-name">{{$npc.name}}</p>
            </div>
            
            <!-- Dialogue Text -->
            <div class="dialogue-text">
                <p id="speech-text" class="speech-text">{{$currentText}}</p>
            </div>
            
            <div class="dialogue-divider"></div>
            
            {{#if showQuestOffer}}
            <!-- Quest Offer Mode -->
            <div class="quest-offer">
                <p class="quest-title">📜 QUEST: {{$quest.name}}</p>
                
                <div class="quest-objectives">
                    {{#each quest.objectives}}
                    <p class="quest-objective-item">• {{$text}}</p>
                    {{/each}}
                </div>
                
                <div class="rewards-section">
                    <p class="rewards-label">REWARDS:</p>
                    <div class="reward-items">
                        {{#each quest.rewards}}
                        <span class="item-slot" 
                              data-hyui-item-id="{{$itemId}}"
                              style="anchor-width: 32; anchor-height: 32;"
                              data-hyui-tooltiptext="{{$name}} x{{$quantity}}">
                        </span>
                        {{/each}}
                        {{#if quest.xpReward}}
                        <p class="reward-xp">+{{$quest.xpReward}} XP</p>
                        {{/if}}
                        {{#if quest.goldReward}}
                        <p class="reward-gold">+{{$quest.goldReward}}g</p>
                        {{/if}}
                    </div>
                </div>
                
                <div class="quest-actions">
                    <button id="btn-decline" class="secondary-button">Decline</button>
                    <button id="btn-accept" class="tertiary-button">Accept Quest</button>
                </div>
            </div>
            {{else}}
            <!-- Normal Dialogue Choices -->
            <div id="choices-container" class="dialogue-choices">
                {{#each choices}}
                <button id="choice-{{$id}}" 
                        class="custom-textbutton dialogue-choice"
                        data-choice-id="{{$id}}"
                        {{#if !available}}data-disabled="true"{{/if}}
                        data-hyui-default-label-style="color: #f4e8d0;"
                        data-hyui-hovered-label-style="color: #ffffff; font-weight: bold;"
                        data-hyui-disabled-label-style="color: #888888;">
                    <span class="choice-number">[{{$index}}]</span>
                    <span class="choice-text">{{$text}}</span>
                    {{#if type}}
                    <span class="choice-type">({{$type}})</span>
                    {{/if}}
                </button>
                {{/each}}
            </div>
            {{/if}}
        </div>
    </div>
    
    <!-- Footer -->
    <div class="dialogue-footer">
        <p class="close-hint">[ESC to close]</p>
    </div>
</div>
